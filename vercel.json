{
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/og/[id].js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/watch/:id", "destination": "/api/og/:id?from=watch" },
    { "source": "/post/:id",  "destination": "/api/og/:id?from=post"  },
    { "source": "/media/:id", "destination": "/api/og/:id?from=media" },
    { "source": "/:path*",    "destination": "/index.html" }
  ]
}
