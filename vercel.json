{
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/shop", "destination": "/shop-index.html" },
    { "source": "/watch/:id", "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/post/:id",  "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/media/:id", "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/track/:id", "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/song/:id",  "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/music/:artist/:song", "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/shop/thanks", "destination": "/app.html" },
    { "source": "/shop/orders", "destination": "/app.html" },
    { "source": "/shop/cart", "destination": "/app.html" },
    { "source": "/shop/checkout", "destination": "/app.html" },
    { "source": "/shop/design", "destination": "/app.html" },
    { "source": "/shop/designs", "destination": "/app.html" },
    { "source": "/shop/library", "destination": "/app.html" },
    { "source": "/shop/:slug", "has": [{"type": "query", "key": "_direct"}], "destination": "/app.html" },
    { "source": "/watch/:id", "destination": "https://backend.thehomies.app/og/watch/:id" },
    { "source": "/post/:id",  "destination": "https://backend.thehomies.app/og/post/:id"  },
    { "source": "/media/:id", "destination": "https://backend.thehomies.app/og/media/:id" },
    { "source": "/track/:id", "destination": "https://backend.thehomies.app/og/track/:id" },
    { "source": "/song/:id",  "destination": "https://backend.thehomies.app/og/song/:id" },
    { "source": "/music/:artist/:song", "destination": "https://backend.thehomies.app/og/music/:artist/:song" },
    { "source": "/shop/:slug", "destination": "https://backend.thehomies.app/og/shop/:slug" },
    { "source": "/merch-cdn/:path*", "destination": "https://homieshub-media.nyc3.cdn.digitaloceanspaces.com/merch/:path*" },
    { "source": "/pf-cdn/m/:path*", "destination": "https://files.cdn.printful.com/m/:path*" },
    { "source": "/pf-cdn/products/:path*", "destination": "https://files.cdn.printful.com/products/:path*" },
    { "source": "/sitemap.xml", "destination": "https://backend.thehomies.app/og/sitemap.xml" },
    { "source": "/((?!\\.well-known/).*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/pf-cdn/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; sandbox" }
      ]
    },
    {
      "source": "/merch-cdn/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; sandbox" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
